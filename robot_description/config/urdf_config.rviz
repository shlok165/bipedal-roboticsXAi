          Show Axes: false
          Show Trail: false
          Value: true
        right_shin:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        right_thigh:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        torso:
