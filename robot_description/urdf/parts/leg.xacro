<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="leg" params="prefix parent *origin">
        <joint name="${prefix}_hip_joint" type="revolute">
            <parent link="${parent}"/>
            <child link="${prefix}_thigh"/>
            <xacro:insert_block name="origin"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.57" upper="1.57" effort="100" velocity="5"/>
        </joint>

        <link name="${prefix}_thigh">
            <visual>
                <geometry>
                        <cylinder radius="0.05" length="0.2"/>
                </geometry>
                    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                        <cylinder radius="0.05" length="0.2"/>
                </geometry>
                    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
            </collision>
            <inertial>
                <!-- CHANGE: Reduced mass from 3.5 to 2.0 -->
                <mass value="4.0"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>

        <joint name="${prefix}_knee_joint" type="revolute">
            <parent link="${prefix}_thigh"/>
            <child link="${prefix}_shin"/>
                <origin xyz="0 0 -0.2" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="1.57" effort="100" velocity="5"/>
        </joint>

        <link name="${prefix}_shin">
            <visual>
                <geometry>
                        <cylinder radius="0.04" length="0.15"/>
                </geometry>
                    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry>
                        <cylinder radius="0.04" length="0.15"/>
                </geometry>leg
                    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
            </collision>
            <inertial>
                <!-- Mass of 1.5 is okay here -->
                <mass value="3.0"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>

        <!-- CRITICAL CHANGE: Replaced fixed joint with a revolute ankle joint -->
        <joint name="${prefix}_ankle_joint" type="revolute">
            <parent link="${prefix}_shin"/>
            <child link="${prefix}_foot"/>
            <origin xyz="0 0 -0.15" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <!-- Limit ankle motion to about +/- 30 degrees -->
            <limit lower="-0.52" upper="0.52" effort="100" velocity="5"/>
        </joint>

        <link name="${prefix}_foot">
            <visual>
                <geometry>
                        <!-- CHANGE: Increased foot length from 0.2 to 0.25 for stability -->
                        <box size="0.15 0.25 0.015"/>
                </geometry>
                    <origin xyz="0.05 0 0" rpy="0 0 1.570796"/>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                       <!-- CHANGE: Increased foot length from 0.2 to 0.25 for stability -->
                       <box size="0.15 0.25 0.015"/>
                </geometry>
                     <origin xyz="0.05 0 0" rpy="0 0 1.570796"/>
            </collision>
             <inertial>
                <!-- Mass of 1.5 is okay here -->
                <mass value="3.5"/>
                <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
            </inertial>
        </link>

        <!-- Add a fixed joint for the foot sensor/contact point if needed later -->
        <joint name="${prefix}_foot_contact_joint" type="fixed">
          <parent link="${prefix}_foot"/>
          <child link="${prefix}_foot_contact"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>
        <link name="${prefix}_foot_contact"/>

    </xacro:macro>

</robot>
